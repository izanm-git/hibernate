<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                      https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
            version="3.0">
   <persistence-unit name="H2_PU" transaction-type="RESOURCE_LOCAL">
       <!-- Proveïdor JPA (Hibernate) -->
       <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
       <!-- Classes entity -->
       <!--<class>com.exemple.model.Persona</class>-->
       <properties>
           <!-- Connexió a la BD H2 (memòria) -->
           <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
           <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1"/>
           <property name="jakarta.persistence.jdbc.user" value="sa"/>
           <property name="jakarta.persistence.jdbc.password" value=""/>
           <!-- Dialecte d’Hibernate per H2 -->
           <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
           <!-- Generació automàtica de l’esquema -->
           <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
           <!-- Mostrar les consultes SQL a la consola -->
           <property name="hibernate.show_sql" value="true"/>
           <property name="hibernate.format_sql" value="true"/>
           <!-- Configuració opcional de log -->
           <property name="hibernate.use_sql_comments" value="true"/>
       </properties>
   </persistence-unit>
</persistence>